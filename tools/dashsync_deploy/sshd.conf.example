# Install this forced-command boundary before adding authorized keys.
# Policy gates, package ownership and key provenance still gate publication.
# PermitUserEnvironment must remain no in the global SSH configuration.
# Validate with sshd -t, keep two administrative sessions, then reload sshd.
Match User dashsync_ryan,dashsync_andrew
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AuthorizedKeysFile /etc/dashsync/authorized_keys/%u
    ForceCommand /usr/bin/python3 -I -S /usr/local/libexec/dashsync/receiver.py
    DisableForwarding yes
    PermitTTY no
    PermitUserRC no
Match all
